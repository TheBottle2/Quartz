{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:allow-resolve",
    "core:path:allow-join",
    "core:path:allow-basename",
    "core:path:allow-dirname",
    "core:path:allow-extname",
    "core:path:allow-is-absolute",
    "core:path:allow-normalize",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-create",
    "fs:allow-remove",
    "fs:allow-read-dir",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:allow-copy-file",
    "fs:scope-appdata",
    "fs:scope-home"
  ]
}